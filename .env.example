# Configuración de Firebase (proyecto web-invitacion-boda).
# Copia este archivo como ".env" y rellena los valores reales.
# Los encuentras en: consola de Firebase → ⚙ Configuración del proyecto →
#   "Tus apps" → app web → SDK setup and configuration → Config.
#
# NOTA: en Vite, todo lo que empieza por VITE_ se incrusta en el bundle del
# cliente. En Firebase web esto es NORMAL y esperado: estas claves son
# identificadores públicos del proyecto, NO secretos. La protección real de
# los datos la dan las REGLAS de Firestore (ver firestore.rules).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

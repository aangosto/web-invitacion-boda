rules_version = '2';

// =====================================================================
// Reglas de seguridad de Firestore — Boda María & Alberto
//
// >>> IMPORTANTE: ESTE ARCHIVO NO SE APLICA SOLO. Publícalo con:
//       firebase deploy --only firestore:rules
//     o pegándolo en la consola: Firestore Database → "Reglas" → Publicar.
//
// Modelo:
//  · scores (ranking del juego): lectura PÚBLICA, se puede CREAR (con
//    validación) y BORRAR solo con sesión (el panel de los novios
//    modera el ranking). No se puede editar desde el cliente.
//  · rsvp (confirmaciones, DATOS SENSIBLES: nombres, alergias=salud, menús):
//    se puede CREAR para confirmar; la LECTURA exige autenticación
//    (request.auth != null): la usa la página privada /resultados vía
//    inicio de sesión ANÓNIMO tras introducir la contraseña.
//  · lugares (puntos de la ilustración interactiva): lectura PÚBLICA
//    (la home los muestra); escritura solo autenticada + validación de
//    forma (la gestiona el panel /resultados).
//  · config (textos editables, p. ej. la frase y el IBAN del regalo):
//    lectura PÚBLICA; escritura solo autenticada (panel /resultados).
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- RANKING DEL JUEGO ----------
    // "Borrar" desde el panel es un SOFT DELETE: update que solo puede
    // tocar el campo `deleted` (papelera). El delete real ("borrar
    // definitivamente") también exige sesión. La web pública filtra
    // deleted != true en el cliente.
    match /scores/{scoreId} {
      allow read: if true;                          // ranking público
      allow create: if isValidScore(request.resource.data);
      // Dos updates posibles:
      //  · Panel (con sesión): solo el campo `deleted` (papelera).
      //  · Público (sin sesión): SOLO poner nombre a una partida que se
      //    guardó anónima (name == ''), y solo UNA vez — con nombre ya
      //    puesto deja de cumplirse resource.data.name == '', así que
      //    nadie puede renombrar puntuaciones ajenas. Es lo que permite
      //    que la partida cuente una única vez: al poner el nombre se
      //    actualiza el registro existente en vez de crear otro.
      allow update: if (request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
          && request.resource.data.deleted is bool)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && resource.data.name == ''
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 40);
      allow delete: if request.auth != null;        // vaciar papelera
    }

    // ---------- CONFIRMACIONES (RSVP) — SENSIBLE ----------
    // Lectura, EDICIÓN y BORRADO solo para peticiones autenticadas: la
    // página privada /resultados hace signInAnonymously() tras la
    // contraseña. Los invitados solo pueden CREAR (con validación).
    // El "borrar" del panel es un soft delete (update deleted:true) y el
    // editar guarda un snapshot `original`; el delete real vacía la
    // papelera. (Requiere el proveedor "Anónimo" en Firebase Auth.)
    match /rsvp/{rsvpId} {
      allow read: if request.auth != null;
      allow create: if isValidRsvp(request.resource.data);
      allow update, delete: if request.auth != null;
    }

    // ---------- LUGARES (ilustración interactiva) ----------
    // Lectura pública: la home pinta los marcadores para todo el mundo.
    // Escritura: exige sesión (anónima) + validación estricta de campos.
    //
    // ⚠️ LIMITACIÓN ASUMIDA (léeme): el panel usa contraseña en cliente +
    // Auth ANÓNIMA, así que cualquiera que abra la web puede obtener una
    // sesión anónima válida y, con esfuerzo, escribir aquí. La validación
    // de forma (tipos, rangos 0-100, longitudes) limita el daño posible a
    // "vandalismo con formato correcto". Esto DIFICULTA, no impide. La
    // solución fuerte sería login real de los novios (email/contraseña)
    // y exigir request.auth.uid == '<uid-de-los-novios>'.
    match /lugares/{lugarId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && isValidLugar(request.resource.data);
      allow delete: if request.auth != null;
    }

    // ---------- AUDITORÍA (registro de visitas y eventos) ----------
    // La web pública CREA eventos (visitas, envíos de RSVP, partidas)
    // sin sesión; la LECTURA exige autenticación, igual que rsvp: solo
    // el panel /resultados puede consultarla. No es pública porque
    // contiene datos de navegación de los invitados (sin IP).
    // Inmutable desde el cliente: sin update; delete solo con sesión
    // (limpieza desde el panel).
    match /auditoria/{eventId} {
      allow read: if request.auth != null;
      allow create: if isValidAudit(request.resource.data);
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // ---------- INVITADOS (gestión interna de la lista) — SENSIBLE ----------
    // Lista completa de invitados por núcleo: nombres reales, estado de
    // confirmación interno y dinero regalado. NADA es público: lectura y
    // escritura exigen sesión (anónima tras la contraseña del panel),
    // igual que auditoria/rsvp. La gestiona la página privada
    // /invitados.html. Misma limitación asumida que en "lugares".
    match /invitados/{nucleoId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isValidNucleo(request.resource.data);
      allow delete: if request.auth != null;
    }

    // ---------- CONFIG (textos editables: regalo/IBAN…) ----------
    // Lectura pública (la home muestra la frase y el IBAN); escritura
    // solo con sesión + validación de forma (misma limitación asumida
    // que en "lugares": disuade, no es seguridad fuerte).
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isValidConfig(request.resource.data);
    }

    // ---------- Validaciones ----------
    function isValidAudit(d) {
      // Validación laxa a propósito: el cliente añade campos de contexto
      // variables (idioma, pantalla, conexión…). Se exige tipo, fecha de
      // servidor y un tope de tamaño para disuadir el abuso.
      return d.tipo is string && d.tipo.size() >= 1 && d.tipo.size() <= 40
        && d.createdAt == request.time             // obliga a serverTimestamp()
        && d.keys().size() <= 25;
    }

    function isValidNucleo(d) {
      // Núcleo de invitados: nombre, lado, etiquetas, personas y regalos.
      // `personas` es una lista de mapas; Firestore rules no puede validar
      // cada elemento de una lista, así que se validan forma y topes.
      // `regalo` (dinero, en €) es number o null (null = sin apuntar).
      // `regaloMaterial` (una vajilla, un electrodoméstico…) es null o
      // { descripcion, valor }: descripción obligatoria y valor ESTIMADO
      // en € opcional (number o null). Dinero y material coexisten.
      return d.keys().hasOnly(['nombre', 'lado', 'etiquetas', 'personas', 'regalo', 'regaloMaterial', 'orden', 'createdAt', 'updatedAt'])
        && d.nombre is string && d.nombre.size() >= 1 && d.nombre.size() <= 120
        && d.lado in ['novia', 'novio', 'ambos']
        && d.etiquetas is list && d.etiquetas.size() <= 15
        && d.personas is list && d.personas.size() <= 40
        && (!('regalo' in d.keys()) || d.regalo == null || (d.regalo is number && d.regalo >= 0 && d.regalo <= 100000))
        && (!('regaloMaterial' in d.keys()) || isValidRegaloMaterial(d.regaloMaterial))
        && (!('orden' in d.keys()) || d.orden is number);
    }

    function isValidRegaloMaterial(m) {
      return m == null || (
        m is map
        && m.keys().hasOnly(['descripcion', 'valor'])
        && m.descripcion is string && m.descripcion.size() >= 1 && m.descripcion.size() <= 300
        && (m.valor == null || (m.valor is number && m.valor >= 0 && m.valor <= 100000))
      );
    }

    function isValidConfig(d) {
      // `titular` (nombre del titular de la cuenta) es opcional.
      return d.keys().hasOnly(['frase', 'iban', 'titular'])
        && d.frase is string && d.frase.size() <= 2000
        && d.iban is string && d.iban.size() <= 60
        && (!('titular' in d.keys()) || (d.titular is string && d.titular.size() <= 120));
    }

    function isValidLugar(d) {
      // `deleted` es la papelera (soft delete); opcional y booleano.
      return d.keys().hasOnly(['x', 'y', 'titulo', 'texto', 'orden', 'deleted'])
        && d.x is number && d.x >= 0 && d.x <= 100
        && d.y is number && d.y >= 0 && d.y <= 100
        && d.titulo is string && d.titulo.size() >= 1 && d.titulo.size() <= 80
        && d.texto is string && d.texto.size() <= 1200
        && d.orden is number && d.orden >= 0 && d.orden <= 999
        && (!('deleted' in d.keys()) || d.deleted is bool);
    }

    function isValidScore(d) {
      // `name` puede ser '' (partida anónima: cuenta para el marcador
      // global pero no sale en el Top 3 hasta que se le ponga nombre).
      return d.keys().hasOnly(['name', 'team', 'points', 'createdAt'])
        && d.name is string && d.name.size() <= 40
        && d.team in ['novia', 'novio']
        && d.points is number && d.points >= 0 && d.points <= 100000
        && d.createdAt == request.time;             // obliga a serverTimestamp()
    }

    function isValidRsvp(d) {
      // Si NO asiste basta { filledBy, attending:false, createdAt }.
      // Si asiste: origin obligatorio, people 1..30 y travel opcional
      // (solo se envía si viene de fuera). `comentario` es el texto
      // libre final del cuestionario: opcional, asista o no.
      return d.keys().hasOnly(['filledBy', 'attending', 'origin', 'people', 'travel', 'comentario', 'createdAt'])
        && d.filledBy is string && d.filledBy.size() >= 1 && d.filledBy.size() <= 120
        && d.attending is bool
        && d.createdAt == request.time              // obliga a serverTimestamp()
        && (!('comentario' in d.keys()) || (d.comentario is string && d.comentario.size() <= 2000))
        && (d.attending == false || (
             d.origin in ['fuera', 'zaragoza']
             && d.people is list && d.people.size() >= 1 && d.people.size() <= 30
             && (!('travel' in d.keys()) || d.travel is map)
           ));
    }

    // ---------- Todo lo demás: denegado por defecto ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
